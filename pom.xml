<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.dofunc</groupId>
    <artifactId>oss-fake-embedded</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>oss-fake-embedded</name>
    <description>Runs oss-go-fake, an Alibaba Cloud OSS emulator, from a JUnit test.</description>
    <url>https://github.com/dofunc/oss-fake-embedded</url>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>dofunc</name>
            <email>developer@dofunc.com</email>
            <organization>dofunc</organization>
            <organizationUrl>https://github.com/dofunc</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/dofunc/oss-fake-embedded.git</connection>
        <developerConnection>scm:git:https://github.com/dofunc/oss-fake-embedded.git</developerConnection>
        <url>https://github.com/dofunc/oss-fake-embedded</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <oss-go-fake.version>0.1.0</oss-go-fake.version>
        <oss-go-fake.release>https://github.com/dofunc/oss-go-fake/releases/download/v${oss-go-fake.version}</oss-go-fake.release>
        <!-- copied from that release's checksums.txt on every version bump, see RELEASING.md -->
        <sha256.darwin-arm64>a35bcbecb2a7e374ef78dc9da8ffcab24204d10df8d3bf90210cca5e70238909</sha256.darwin-arm64>
        <sha256.darwin-amd64>a77d3c79f1eee6993dc5c163a46d792444d26039855d9a8ffdb0baf37cf6ad1d</sha256.darwin-amd64>
        <sha256.linux-amd64>7bade58460ff7333f9fdec040bbfa45cccf3f83867fdbf286b55864fb45d3bbc</sha256.linux-amd64>
        <sha256.linux-arm64>dd060f645bd00a85e1a89db855b4d85077957c9b987e783359fec2be4442350b</sha256.linux-arm64>
        <sha256.windows-amd64>a89f6f8876f06d90a00edea15099eaec56e7886cff760d3f5343eea2c1276bf0</sha256.windows-amd64>
        <oss-go-fake.download.skip>false</oss-go-fake.download.skip>

        <slf4j.version>2.0.20</slf4j.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>3.18.5</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
            </plugin>

            <!-- Puts every platform's oss-go-fake binary into the jar, straight from the GitHub release.
                 The sha256 check fails the build on any mismatch; downloads are cached in ~/.m2. -->
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>1.13.0</version>
                <configuration>
                    <skip>${oss-go-fake.download.skip}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>darwin-arm64</id>
                        <phase>generate-resources</phase>
                        <goals><goal>wget</goal></goals>
                        <configuration>
                            <uri>${oss-go-fake.release}/oss-go-fake-darwin-arm64</uri>
                            <outputDirectory>${project.build.outputDirectory}/oss-fake/darwin-arm64</outputDirectory>
                            <outputFileName>oss-go-fake</outputFileName>
                            <sha256>${sha256.darwin-arm64}</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>darwin-amd64</id>
                        <phase>generate-resources</phase>
                        <goals><goal>wget</goal></goals>
                        <configuration>
                            <uri>${oss-go-fake.release}/oss-go-fake-darwin-amd64</uri>
                            <outputDirectory>${project.build.outputDirectory}/oss-fake/darwin-amd64</outputDirectory>
                            <outputFileName>oss-go-fake</outputFileName>
                            <sha256>${sha256.darwin-amd64}</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>linux-amd64</id>
                        <phase>generate-resources</phase>
                        <goals><goal>wget</goal></goals>
                        <configuration>
                            <uri>${oss-go-fake.release}/oss-go-fake-linux-amd64</uri>
                            <outputDirectory>${project.build.outputDirectory}/oss-fake/linux-amd64</outputDirectory>
                            <outputFileName>oss-go-fake</outputFileName>
                            <sha256>${sha256.linux-amd64}</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>linux-arm64</id>
                        <phase>generate-resources</phase>
                        <goals><goal>wget</goal></goals>
                        <configuration>
                            <uri>${oss-go-fake.release}/oss-go-fake-linux-arm64</uri>
                            <outputDirectory>${project.build.outputDirectory}/oss-fake/linux-arm64</outputDirectory>
                            <outputFileName>oss-go-fake</outputFileName>
                            <sha256>${sha256.linux-arm64}</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- GoReleaser keeps the .exe in binary archives -->
                        <id>windows-amd64</id>
                        <phase>generate-resources</phase>
                        <goals><goal>wget</goal></goals>
                        <configuration>
                            <uri>${oss-go-fake.release}/oss-go-fake-windows-amd64.exe</uri>
                            <outputDirectory>${project.build.outputDirectory}/oss-fake/windows-amd64</outputDirectory>
                            <outputFileName>oss-go-fake.exe</outputFileName>
                            <sha256>${sha256.windows-amd64}</sha256>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Bundles a local GoReleaser snapshot (goreleaser release snapshot clean skip docker) instead of
             the GitHub release. For trying oss-go-fake changes before they are released; never used by
             CI or for publishing. -->
        <profile>
            <id>local-dist</id>
            <properties>
                <oss-go-fake.download.skip>true</oss-go-fake.download.skip>
                <oss-go-fake.dist>${project.basedir}/../../golang/oss-go-fake/dist</oss-go-fake.dist>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>local-dist-darwin-arm64</id>
                                <phase>generate-resources</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/oss-fake/darwin-arm64</outputDirectory>
                                    <resources><resource><directory>${oss-go-fake.dist}/oss-go-fake_darwin_arm64_v8.0</directory></resource></resources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>local-dist-darwin-amd64</id>
                                <phase>generate-resources</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/oss-fake/darwin-amd64</outputDirectory>
                                    <resources><resource><directory>${oss-go-fake.dist}/oss-go-fake_darwin_amd64_v1</directory></resource></resources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>local-dist-linux-amd64</id>
                                <phase>generate-resources</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/oss-fake/linux-amd64</outputDirectory>
                                    <resources><resource><directory>${oss-go-fake.dist}/oss-go-fake_linux_amd64_v1</directory></resource></resources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>local-dist-linux-arm64</id>
                                <phase>generate-resources</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/oss-fake/linux-arm64</outputDirectory>
                                    <resources><resource><directory>${oss-go-fake.dist}/oss-go-fake_linux_arm64_v8.0</directory></resource></resources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>local-dist-windows-amd64</id>
                                <phase>generate-resources</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/oss-fake/windows-amd64</outputDirectory>
                                    <resources><resource><directory>${oss-go-fake.dist}/oss-go-fake_windows_amd64_v1</directory></resource></resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Maven Central: sources, javadoc, GPG signatures, then upload through the Central Portal.
             Credentials come from the server "central" in settings.xml, the GPG passphrase from
             MAVEN_GPG_PASSPHRASE. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <!-- builder setters say what they do in their names -->
                            <doclint>all,-missing</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
